# ─────────────────────────────────────────────────────────────
#  API 키 설정 파일
#  1) 이 파일을 복사해서 이름을 ".env" 로 바꾸세요.
#  2) = 뒤에 발급받은 키를 붙여넣으세요. (따옴표 없이, 띄어쓰기 없이)
#  3) .env 파일은 절대 다른 사람에게 보여주거나 인터넷에 올리지 마세요!
# ─────────────────────────────────────────────────────────────

# [필수: 원고 생성 + 사실 검증] Claude API 키 - https://console.anthropic.com
ANTHROPIC_API_KEY=

# [일러스트] 어떤 이미지 API를 쓸지 고르세요: none / openai / gemini
#   none 이면 일러스트 없이 "텍스트 카드 전용 모드"로 만듭니다.
IMAGE_PROVIDER=none

# IMAGE_PROVIDER=openai 일 때 - https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# IMAGE_PROVIDER=gemini 일 때 - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
