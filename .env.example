# ─────────────────────────────────────────────────────────────
#  API 키 설정 파일
#  1) 이 파일을 복사해서 이름을 ".env" 로 바꾸세요. (install.bat 이 자동으로 해줍니다)
#  2) 아래 = 뒤에 발급받은 키를 붙여넣으세요. (따옴표 없이, 띄어쓰기 없이)
#  3) .env 파일은 절대 다른 사람에게 보여주거나 인터넷에 올리지 마세요!
# ─────────────────────────────────────────────────────────────

# [필수: 대본 생성] Claude API 키 - https://console.anthropic.com
ANTHROPIC_API_KEY=

# [리서치 탭] YouTube Data API v3 키 - https://console.cloud.google.com
YOUTUBE_API_KEY=

# [소재 탭] 무료 스톡 영상/이미지 (둘 중 하나만 있어도 됩니다)
# Pexels  - https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay - https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# [선택] 유료 고품질 TTS (없으면 무료 edge-tts 를 사용합니다)
ELEVENLABS_API_KEY=
TYPECAST_API_KEY=
